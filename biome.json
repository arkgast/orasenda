{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!design/system",
      "!design/reviews/05-v34",
      "!.baton",
      "!apps/orasenda/src/shared/ipc/bindings.ts",
      "!packages/tokens/tokens.css",
      "!packages/tokens/tokens.json",
      "!packages/tokens/theme.css",
      "!packages/ui/design-system/Cover",
      "!**/src-tauri/gen",
      "!**/dist",
      "!**/target"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/index.ts"],
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    },
    {
      "includes": ["apps/orasenda/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@surfaces/*"],
                    "message": "shared/ imports nothing above it; surfaces/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@app/*"],
                    "message": "shared/ imports nothing above it; app/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@features/*"],
                    "message": "shared/ imports nothing above it; features/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@domain/*"],
                    "message": "shared/ imports nothing above it; domain/ is a higher layer (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/orasenda/src/shared/*.ts", "apps/orasenda/src/shared/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@surfaces/*"],
                    "message": "shared/ imports nothing above it; surfaces/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@app/*"],
                    "message": "shared/ imports nothing above it; app/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@features/*"],
                    "message": "shared/ imports nothing above it; features/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@domain/*"],
                    "message": "shared/ imports nothing above it; domain/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["../**"],
                    "message": "A relative import must stay inside the shared/ folder; use an alias across layers (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/orasenda/src/shared/*/*.ts", "apps/orasenda/src/shared/*/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@surfaces/*"],
                    "message": "shared/ imports nothing above it; surfaces/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@app/*"],
                    "message": "shared/ imports nothing above it; app/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@features/*"],
                    "message": "shared/ imports nothing above it; features/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@domain/*"],
                    "message": "shared/ imports nothing above it; domain/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "A relative import must stay inside the shared/ folder; use an alias across layers (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/orasenda/src/shared/*/*/*.ts", "apps/orasenda/src/shared/*/*/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@surfaces/*"],
                    "message": "shared/ imports nothing above it; surfaces/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@app/*"],
                    "message": "shared/ imports nothing above it; app/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@features/*"],
                    "message": "shared/ imports nothing above it; features/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["@domain/*"],
                    "message": "shared/ imports nothing above it; domain/ is a higher layer (ADR-021)."
                  },
                  {
                    "group": ["../../../**"],
                    "message": "A relative import must stay inside the shared/ folder; use an alias across layers (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/orasenda/src/shared/test/*.ts",
        "apps/orasenda/src/shared/test/*.tsx",
        "apps/orasenda/src/shared/*/*.test.ts",
        "apps/orasenda/src/shared/*/*.test.tsx",
        "apps/orasenda/src/shared/*/*.support.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**"],
                    "message": "A relative import must stay inside the shared/ folder; use an alias across layers (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/orasenda/src/shared/test/*/*.ts", "apps/orasenda/src/shared/test/*/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../../**"],
                    "message": "A relative import must stay inside the shared/ folder; use an alias across layers (ADR-021)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
