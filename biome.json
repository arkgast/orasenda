{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!design/system",
      "!design/reviews/05-v34",
      "!.baton",
      "!apps/orasenda/src/bindings.ts",
      "!packages/tokens/tokens.css",
      "!packages/tokens/tokens.json",
      "!packages/tokens/theme.css",
      "!packages/ui/design-system/Cover",
      "!packages/ui/src/legacy.js",
      "!packages/ui/src/legacy.css",
      "!packages/ui/src/legacy.d.ts",
      "!**/src-tauri/gen",
      "!**/dist",
      "!**/target"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/index.ts"],
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
