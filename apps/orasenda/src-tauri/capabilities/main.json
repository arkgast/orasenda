{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window's webview may do: call its app commands and listen to events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-timer-state",
    "allow-timer-start",
    "allow-timer-pause",
    "allow-timer-resume",
    "allow-timer-stop",
    "allow-timer-extend",
    "allow-timer-set-intent",
    "allow-timer-dismiss-offer",
    "allow-timer-take-break",
    "allow-hint-shown",
    "allow-tip-seen",
    "allow-settings-get",
    "allow-settings-set",
    "allow-notifications-request",
    "allow-notifications-open-settings",
    "allow-navigate-take",
    "allow-presets-list",
    "allow-native-menu-popup",
    "allow-displays-list",
    "allow-focus-view-open",
    "allow-preset-add",
    "allow-preset-update",
    "allow-preset-remove",
    "allow-preset-undo-remove",
    "allow-presets-restore-defaults",
    "allow-keyboard-state",
    "allow-keyboard-set-shortcut",
    "allow-keyboard-restore-default",
    "allow-inbox-list",
    "allow-inbox-remove",
    "allow-inbox-restore",
    "allow-capture-open"
  ]
}
