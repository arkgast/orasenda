{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window's webview may do: call app_info and the dev panel's spike commands, and listen to events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-timer-state",
    "allow-timer-start",
    "allow-timer-pause",
    "allow-timer-resume",
    "allow-timer-stop",
    "allow-settings-get",
    "allow-settings-set",
    "allow-notifications-request",
    "allow-notifications-open-settings",
    "allow-navigate-take",
    "allow-presets-get",
    "allow-native-menu-popup",
    "allow-spike-status",
    "allow-spike-running-apps",
    "allow-spike-rule",
    "allow-spike-set-rule",
    "allow-spike-usage"
  ]
}
