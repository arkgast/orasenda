{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev",
  "description": "What the Developer panel window's webview may do: call the spike's panel commands and listen to events.",
  "windows": ["dev"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-spike-status",
    "allow-spike-running-apps",
    "allow-spike-rule",
    "allow-spike-set-rule",
    "allow-spike-usage"
  ]
}
